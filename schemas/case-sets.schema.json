{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:werkbank:case-sets:1.0.0",
  "title": "Werkbank case sets",
  "description": "The named case sets the package ships (src/victors_werkbank/case_sets.json), data outside the harness digest: each set a fixed list of registered case IDs in run order, of scored cases alone or of the cases of one module alone, and the sets with a weighted overall score of their own, never a module's",
  "type": "object",
  "properties": {
    "sets": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[A-Z]{1,2}[0-9]{2}$"
        }
      }
    },
    "scored": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
      }
    }
  },
  "required": [
    "scored",
    "sets"
  ],
  "additionalProperties": false
}
